{
  "name": "trading-orders-api",
  "version": "1.0.0",
  "description": "Trading orders API for prediction markets",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "ci": "npm run type-check && npm run lint && npm run test && npm run build",
    "clean": "rimraf dist coverage"
  },
  "keywords": [
    "trading",
    "api",
    "prediction-markets"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "fast-check": "^3.15.0",
    "jest": "^29.5.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^8.4.0",
    "@prisma/client": "^5.6.0",
    "fastify": "^4.24.0",
    "prisma": "^5.6.0",
    "redis": "^4.6.0"
  }
}
